<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Konsekuensi Aka Tracker</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #0f172a;
    color: #e5e7eb;
}

.container {
    max-width: 900px;
    margin: auto;
    padding: 20px;
}

.hero {
    background: linear-gradient(135deg, #1e293b, #111827);
    padding: 24px;
    border-radius: 20px;
    margin-bottom: 18px;
    border: 1px solid #334155;
}

h1 {
    margin: 0 0 8px;
    font-size: 27px;
}

.muted {
    color: #94a3b8;
    font-size: 14px;
}

.toolbar {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin: 15px 0;
}

button {
    border: 0;
    border-radius: 10px;
    padding: 11px 15px;
    cursor: pointer;
    font-weight: bold;
}

.primary {
    background: #22c55e;
    color: #052e16;
}

.secondary {
    background: #334155;
    color: white;
}

.danger {
    background: #ef4444;
    color: white;
}

input,
textarea {
    width: 100%;
    background: #111827;
    color: white;
    border: 1px solid #475569;
    border-radius: 10px;
    padding: 11px;
}

.card {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 16px;
    padding: 17px;
    margin: 12px 0;
}

.dayhead {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
}

.datebox {
    display: flex;
    gap: 8px;
    align-items: center;
}

.datebox input {
    width: auto;
}

.progress {
    height: 12px;
    background: #0f172a;
    border-radius: 99px;
    overflow: hidden;
    margin: 12px 0;
}

.bar {
    height: 100%;
    background: #22c55e;
    width: 0%;
    transition: 0.25s;
}

.item {
    background: #111827;
    border-radius: 13px;
    padding: 14px;
    margin: 10px 0;
    border: 1px solid #334155;
}

.item.done {
    border-color: #22c55e;
}

.row {
    display: flex;
    gap: 12px;
    align-items: flex-start;
}

.check {
    width: 22px;
    height: 22px;
    margin-top: 2px;
    accent-color: #22c55e;
}

.title {
    font-weight: bold;
}

.status {
    font-size: 12px;
    color: #94a3b8;
    margin-top: 5px;
}

.proof {
    margin-top: 10px;
    display: none;
}

.done .proof {
    display: block;
}

.stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
}

.stat {
    background: #111827;
    border-radius: 13px;
    padding: 14px;
    text-align: center;
}

.num {
    font-size: 25px;
    font-weight: 800;
}

.small {
    font-size: 12px;
    color: #94a3b8;
}

.footer {
    text-align: center;
    color: #64748b;
    padding: 20px;
}

@media(max-width:600px) {
    .stats {
        grid-template-columns: 1fr 1fr;
    }

    .container {
        padding: 12px;
    }

    h1 {
        font-size: 23px;
    }
}
</style>
</head>

<body>

<div class="container">

<!-- HEADER -->
<section class="hero">
    <h1>🔥 Konsekuensi Aka — Daily Tracker</h1>

    <div class="muted">
        Catat pemenuhan konsekuensi setiap hari.
        Data tersimpan otomatis di browser.
    </div>
</section>


<!-- STATISTIK -->
<div class="stats">

    <div class="stat">
        <div class="num" id="totalDone">0</div>
        <div class="small">
            Selesai hari ini
        </div>
    </div>

    <div class="stat">
        <div class="num" id="percent">0%</div>
        <div class="small">
            Progress hari ini
        </div>
    </div>

    <div class="stat">
        <div class="num" id="daysDone">0</div>
        <div class="small">
            Hari lengkap
        </div>
    </div>

</div>


<!-- PILIH TANGGAL -->
<div class="card">

    <div class="dayhead">

        <div>
            <b>Pilih tanggal</b>

            <div class="small">
                Contoh: Kamis = Hari Pertama
            </div>
        </div>

        <div class="datebox">

            <input
                type="date"
                id="datePicker"
            >

            <button
                class="secondary"
                onclick="today()"
            >
                Hari Ini
            </button>

        </div>

    </div>


    <!-- PROGRESS -->
    <div class="progress">

        <div
            class="bar"
            id="bar"
        ></div>

    </div>

    <div
        id="progressText"
        class="small"
    >
        0 dari 6 terpenuhi
    </div>

</div>


<!-- LIST KONSEKUENSI -->
<div id="list"></div>


<!-- BUTTON -->
<div class="toolbar">

    <button
        class="primary"
        onclick="save()"
    >
        💾 Simpan
    </button>


    <button
        class="secondary"
        onclick="exportData()"
    >
        📤 Export Data
    </button>


    <button
        class="secondary"
        onclick="importData()"
    >
        📥 Import Data
    </button>


    <button
        class="danger"
        onclick="resetDay()"
    >
        🗑️ Reset Hari Ini
    </button>

</div>


<!-- CATATAN -->
<div class="card">

    <h3>
        📝 Catatan Hari
    </h3>

    <textarea
        id="dayNote"
        rows="4"
        placeholder="Contoh: Hari pertama semua konsekuensi sudah terpenuhi..."
    ></textarea>

</div>


<!-- DAFTAR KONSEKUENSI -->
<div class="card">

    <h3>
        📋 Daftar Konsekuensi
    </h3>

    <div class="small">

        1. Push Up 30x
        <br><br>

        2. Keliling lapangan 3x
        <br><br>

        3. Mandi 2x sehari
        <br><br>

        4. Belajar 3x seminggu,
        maksimal 30 menit–1 jam per sesi
        <br><br>

        5. Joging minimal 5 km/jam
        + bukti aplikasi
        <br><br>

        6. Membuat klarifikasi di second
        selama 1 bulan

    </div>

</div>


<div class="footer">

    Konsekuensi Aka Tracker
    <br>
    Data tersimpan secara lokal di browser.

</div>

</div>


<script>

/* =========================================
   DATABASE LOCAL STORAGE
========================================= */

const KEY = "konsekuensi_aka_v1";

let db = JSON.parse(
    localStorage.getItem(KEY) || "{}"
);

let selected = "";


/* =========================================
   DAFTAR KONSEKUENSI
========================================= */

const consequences = [

    [
        "pushup",
        "Push Up 30x",
        "Isi bukti/catatan jika sudah selesai."
    ],

    [
        "lapangan",
        "Keliling Lapangan 3x",
        "Isi lokasi atau catatan."
    ],

    [
        "mandi",
        "Mandi 2x Sehari",
        "Bisa tulis jam mandi pertama/kedua."
    ],

    [
        "belajar",
        "Belajar 3x Seminggu — 30 Menit–1 Jam",
        "Isi materi dan durasi."
    ],

    [
        "joging",
        "Joging Minimal 5 km/jam + Bukti",
        "Masukkan nama aplikasi dan bukti."
    ],

    [
        "klarifikasi",
        "Klarifikasi di Second — 1 Bulan",
        "Isi tanggal/status klarifikasi."
    ]

];


/* =========================================
   TANGGAL HARI INI
========================================= */

function dateNow() {

    const d = new Date();

    return d.toISOString().slice(0, 10);

}


/* =========================================
   TOMBOL HARI INI
========================================= */

function today() {

    document.getElementById(
        "datePicker"
    ).value = dateNow();

    load();

}


/* =========================================
   AMBIL DATA HARI
========================================= */

function getDay() {

    if (!db[selected]) {

        db[selected] = {

            items: {},

            note: ""

        };

    }

    return db[selected];

}


/* =========================================
   SIMPAN DATABASE
========================================= */

function saveDB() {

    localStorage.setItem(
        KEY,
        JSON.stringify(db)
    );

}


/* =========================================
   LOAD DATA
========================================= */

function load() {

    selected =
        document.getElementById(
            "datePicker"
        ).value || dateNow();


    const d = getDay();


    const list =
        document.getElementById(
            "list"
        );


    list.innerHTML = "";


    consequences.forEach(
        (c, i) => {

            const done =
                !!d.items[c[0]]?.done;


            const proof =
                d.items[c[0]]?.proof || "";


            list.innerHTML += `

            <div
                class="item ${done ? "done" : ""}"
            >

                <div class="row">

                    <input
                        class="check"
                        type="checkbox"

                        ${done ? "checked" : ""}

                        onchange="
                            toggle(
                                '${c[0]}',
                                this.checked
                            )
                        "
                    >


                    <div style="flex:1">

                        <div class="title">

                            ${i + 1}.
                            ${c[1]}

                        </div>


                        <div class="status">

                            ${
                                done
                                ? "✅ Terpenuhi"
                                : "⏳ Belum terpenuhi"
                            }

                            —

                            ${c[2]}

                        </div>


                        <div class="proof">

                            <input

                                value="${escapeAttr(proof)}"

                                placeholder="
                                Bukti / catatan / link...
                                "

                                onchange="
                                    setProof(
                                        '${c[0]}',
                                        this.value
                                    )
                                "

                            >

                        </div>

                    </div>

                </div>

            </div>

            `;

        }
    );


    document.getElementById(
        "dayNote"
    ).value = d.note || "";


    updateStats();

}


/* =========================================
   CHECKLIST
========================================= */

function toggle(id, val) {

    const d = getDay();


    d.items[id] = {

        done: val,

        proof:
            d.items[id]?.proof || ""

    };


    saveDB();

    load();

}


/* =========================================
   BUKTI / CATATAN
========================================= */

function setProof(id, val) {

    const d = getDay();


    d.items[id] =
        d.items[id] || {

            done: false,

            proof: ""

        };


    d.items[id].proof = val;


    saveDB();

    updateStats();

}


/* =========================================
   SIMPAN
========================================= */

function save() {

    getDay().note =
        document.getElementById(
            "dayNote"
        ).value;


    saveDB();

    load();


    alert(
        "Data hari " +
        selected +
        " berhasil disimpan."
    );

}


/* =========================================
   UPDATE STATISTIK
========================================= */

function updateStats() {

    const d = getDay();

    let n = 0;


    consequences.forEach(
        c => {

            if (
                d.items[c[0]]?.done
            ) {

                n++;

            }

        }
    );


    const p =
        Math.round(
            n / 6 * 100
        );


    document.getElementById(
        "totalDone"
    ).textContent = n;


    document.getElementById(
        "percent"
    ).textContent = p + "%";


    document.getElementById(
        "bar"
    ).style.width = p + "%";


    document.getElementById(
        "progressText"
    ).textContent =
        n + " dari 6 terpenuhi";


    /* HITUNG HARI LENGKAP */

    let days = 0;


    Object.values(db).forEach(
        x => {

            if (
                consequences.every(
                    c =>
                        x.items?.[c[0]]?.done
                )
            ) {

                days++;

            }

        }
    );


    document.getElementById(
        "daysDone"
    ).textContent = days;

}


/* =========================================
   RESET HARI
========================================= */

function resetDay() {

    if (
        confirm(
            "Reset semua data untuk tanggal "
            + selected
            + "?"
        )
    ) {

        delete db[selected];

        saveDB();

        load();

    }

}


/* =========================================
   ESCAPE INPUT
========================================= */

function escapeAttr(s) {

    return String(s)

        .replace(
            /&/g,
            "&amp;"
        )

        .replace(
            /"/g,
            "&quot;"
        )

        .replace(
            /</g,
            "&lt;"
        )

        .replace(
            />/g,
            "&gt;"
        );

}


/* =========================================
   EXPORT DATA
========================================= */

function exportData() {

    const blob =
        new Blob(
            [
                JSON.stringify(
                    db,
                    null,
                    2
                )
            ],
            {
                type:
                    "application/json"
            }
        );


    const a =
        document.createElement(
            "a"
        );


    a.href =
        URL.createObjectURL(
            blob
        );


    a.download =
        "konsekuensi-aka-data.json";


    a.click();

}


/* =========================================
   IMPORT DATA
========================================= */

function importData() {

    const inp =
        document.createElement(
            "input"
        );


    inp.type = "file";

    inp.accept = ".json";


    inp.onchange = () => {

        const r =
            new FileReader();


        r.onload = () => {

            try {

                db =
                    JSON.parse(
                        r.result
                    );


                saveDB();

                load();


                alert(
                    "Data berhasil di-import."
                );


            } catch (e) {

                alert(
                    "File tidak valid."
                );

            }

        };


        r.readAsText(
            inp.files[0]
        );

    };


    inp.click();

}


/* =========================================
   EVENT
========================================= */

document
    .getElementById(
        "datePicker"
    )
    .addEventListener(
        "change",
        load
    );


document
    .getElementById(
        "dayNote"
    )
    .addEventListener(
        "input",
        () => {

            getDay().note =
                document.getElementById(
                    "dayNote"
                ).value;


            saveDB();

        }
    );


/* =========================================
   START
========================================= */

document.getElementById(
    "datePicker"
).value = dateNow();


load();

</script>

</body>
</html>
