<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Consequence Tracker</title>

<style>
:root {
    --bg: #0f172a;
    --card: #1e293b;
    --card2: #111827;
    --border: #334155;
    --text: #f8fafc;
    --muted: #94a3b8;
    --blue: #3b82f6;
    --green: #22c55e;
    --red: #ef4444;
    --yellow: #f59e0b;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background: var(--bg);
    color: var(--text);
}

header {
    padding: 30px 20px;
    text-align: center;
    background: linear-gradient(135deg, #1e3a8a, #312e81);
}

header h1 {
    margin: 0 0 10px;
    font-size: 32px;
}

header p {
    margin: 0;
    color: #cbd5e1;
}

.container {
    width: min(1100px, 94%);
    margin: 30px auto;
}

.card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 22px;
    margin-bottom: 20px;
}

.card h2 {
    margin-top: 0;
}

.warning {
    background: #451a03;
    border: 1px solid #92400e;
    padding: 16px;
    border-radius: 12px;
    line-height: 1.6;
    margin-bottom: 20px;
}

input,
select,
textarea {
    width: 100%;
    padding: 12px;
    margin-top: 7px;
    margin-bottom: 15px;
    border-radius: 9px;
    border: 1px solid #475569;
    background: #0f172a;
    color: white;
}

input[type="checkbox"] {
    width: auto;
    margin: 0;
}

label {
    color: #cbd5e1;
    font-size: 14px;
}

button {
    border: none;
    border-radius: 9px;
    padding: 12px 18px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.2s;
}

button:hover {
    transform: translateY(-1px);
    opacity: .9;
}

.btn-blue {
    background: var(--blue);
    color: white;
}

.btn-green {
    background: var(--green);
    color: #052e16;
}

.btn-red {
    background: var(--red);
    color: white;
}

.btn-gray {
    background: #475569;
    color: white;
}

.stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
}

.stat {
    background: var(--card2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 18px;
    text-align: center;
}

.stat-number {
    font-size: 28px;
    font-weight: bold;
    color: #60a5fa;
}

.stat-label {
    color: var(--muted);
    font-size: 13px;
    margin-top: 5px;
}

.progress-wrapper {
    margin-top: 20px;
}

.progress-bg {
    width: 100%;
    height: 20px;
    background: #334155;
    border-radius: 20px;
    overflow: hidden;
}

.progress {
    height: 100%;
    width: 0%;
    background: var(--green);
    transition: .3s;
}

.progress-text {
    text-align: center;
    margin-top: 8px;
    color: var(--muted);
}

.consequence {
    background: #0f172a;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 18px;
    margin-bottom: 15px;
}

.consequence-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
}

.consequence-title {
    font-size: 17px;
    font-weight: bold;
}

.target {
    color: #60a5fa;
    font-size: 13px;
    margin-top: 5px;
}

.status {
    padding: 7px 12px;
    border-radius: 30px;
    font-size: 12px;
    font-weight: bold;
    white-space: nowrap;
}

.status-pending {
    background: #422006;
    color: #fbbf24;
}

.status-done {
    background: #052e16;
    color: #4ade80;
}

.status-failed {
    background: #450a0a;
    color: #f87171;
}

.check-area {
    display: flex;
    gap: 10px;
    align-items: center;
    margin: 10px 0;
}

.history-item {
    background: #0f172a;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 12px;
}

.history-header {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 10px;
}

.approved {
    color: #4ade80;
}

.not-approved {
    color: #fbbf24;
}

.penalty-box {
    background: #450a0a;
    border: 1px solid #991b1b;
    padding: 15px;
    border-radius: 10px;
    line-height: 1.7;
}

.success-box {
    background: #052e16;
    border: 1px solid #166534;
    padding: 15px;
    border-radius: 10px;
    line-height: 1.7;
}

.buttons {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

.small {
    color: var(--muted);
    font-size: 13px;
}

footer {
    text-align: center;
    color: var(--muted);
    padding: 30px;
}

@media(max-width: 700px) {

    .stats {
        grid-template-columns: repeat(2, 1fr);
    }

    .consequence-top {
        flex-direction: column;
        align-items: flex-start;
    }

    header h1 {
        font-size: 25px;
    }
}
</style>
</head>

<body>

<header>
    <h1>⚡ CONSEQUENCE TRACKER</h1>
    <p>Daily Accountability System</p>
</header>

<div class="container">

    <div class="warning">
        <strong>DISCLAIMER</strong><br>
        Sistem ini digunakan sebagai pencatatan dan accountability pribadi.
        Jangan memaksakan aktivitas fisik apabila sedang sakit, cedera,
        pusing, atau kondisi tubuh tidak memungkinkan.
    </div>


    <!-- DATE -->
    <div class="card">

        <h2>📅 Data Hari</h2>

        <label>Tanggal</label>
        <input type="date" id="date">

        <label>Nama</label>
        <input
            type="text"
            id="name"
            placeholder="Masukkan nama"
        >

        <div class="buttons">
            <button class="btn-blue" onclick="loadDay()">
                📂 Load Data
            </button>

            <button class="btn-gray" onclick="newDay()">
                🆕 Hari Baru
            </button>
        </div>

    </div>


    <!-- STATISTICS -->
    <div class="card">

        <h2>📊 Progress Hari Ini</h2>

        <div class="stats">

            <div class="stat">
                <div class="stat-number" id="total">
                    6
                </div>

                <div class="stat-label">
                    Total
                </div>
            </div>

            <div class="stat">
                <div class="stat-number" id="done">
                    0
                </div>

                <div class="stat-label">
                    Terpenuhi
                </div>
            </div>

            <div class="stat">
                <div class="stat-number" id="failed">
                    0
                </div>

                <div class="stat-label">
                    Gagal
                </div>
            </div>

            <div class="stat">
                <div class="stat-number" id="percent">
                    0%
                </div>

                <div class="stat-label">
                    Progress
                </div>
            </div>

        </div>

        <div class="progress-wrapper">

            <div class="progress-bg">
                <div
                    class="progress"
                    id="progress"
                ></div>
            </div>

            <div
                class="progress-text"
                id="progressText"
            >
                0 / 6
            </div>

        </div>

    </div>


    <!-- CONSEQUENCES -->
    <div class="card">

        <h2>⚠️ Konsekuensi</h2>


        <!-- 1 -->
        <div class="consequence">

            <div class="consequence-top">

                <div>
                    <div class="consequence-title">
                        1️⃣ Push Up
                    </div>

                    <div class="target">
                        Target dasar: 30x
                    </div>
                </div>

                <span
                    id="status1"
                    class="status status-pending"
                >
                    BELUM
                </span>

            </div>

            <label>
                Jumlah push up
            </label>

            <input
                type="number"
                id="pushup"
                min="0"
                placeholder="Contoh: 30"
            >

            <div class="check-area">
                <input
                    type="checkbox"
                    id="check1"
                >

                <label>
                    Saya menyatakan konsekuensi ini
                    telah terpenuhi
                </label>
            </div>

            <button
                class="btn-green"
                onclick="approveItem(1)"
            >
                ✓ ACC
            </button>

        </div>


        <!-- 2 -->
        <div class="consequence">

            <div class="consequence-top">

                <div>
                    <div class="consequence-title">
                        2️⃣ Keliling Lapangan
                    </div>

                    <div class="target">
                        Target dasar: 3x
                    </div>
                </div>

                <span
                    id="status2"
                    class="status status-pending"
                >
                    BELUM
                </span>

            </div>

            <label>
                Jumlah putaran
            </label>

            <input
                type="number"
                id="lapangan"
                min="0"
                placeholder="Contoh: 3"
            >

            <div class="check-area">

                <input
                    type="checkbox"
                    id="check2"
                >

                <label>
                    Saya menyatakan konsekuensi ini
                    telah terpenuhi
                </label>

            </div>

            <button
                class="btn-green"
                onclick="approveItem(2)"
            >
                ✓ ACC
            </button>

        </div>


        <!-- 3 -->
        <div class="consequence">

            <div class="consequence-top">

                <div>
                    <div class="consequence-title">
                        3️⃣ Mandi
                    </div>

                    <div class="target">
                        Target dasar: 2x sehari
                    </div>
                </div>

                <span
                    id="status3"
                    class="status status-pending"
                >
                    BELUM
                </span>

            </div>

            <label>
                Jumlah mandi
            </label>

            <input
                type="number"
                id="mandi"
                min="0"
                placeholder="Contoh: 2"
            >

            <div class="check-area">

                <input
                    type="checkbox"
                    id="check3"
                >

                <label>
                    Saya menyatakan konsekuensi ini
                    telah terpenuhi
                </label>

            </div>

            <button
                class="btn-green"
                onclick="approveItem(3)"
            >
                ✓ ACC
            </button>

        </div>


        <!-- 4 -->
        <div class="consequence">

            <div class="consequence-top">

                <div>
                    <div class="consequence-title">
                        4️⃣ Belajar
                    </div>

                    <div class="target">
                        Target: 3x seminggu,
                        30-60 menit/sesi
                    </div>
                </div>

                <span
                    id="status4"
                    class="status status-pending"
                >
                    BELUM
                </span>

            </div>

            <label>
                Jumlah sesi belajar minggu ini
            </label>

            <input
                type="number"
                id="belajarSesi"
                min="0"
                placeholder="Contoh: 3"
            >

            <label>
                Durasi sesi hari ini (menit)
            </label>

            <input
                type="number"
                id="belajarMenit"
                min="0"
                placeholder="Contoh: 45"
            >

            <div class="check-area">

                <input
                    type="checkbox"
                    id="check4"
                >

                <label>
                    Saya menyatakan konsekuensi ini
                    telah terpenuhi
                </label>

            </div>

            <button
                class="btn-green"
                onclick="approveItem(4)"
            >
                ✓ ACC
            </button>

        </div>


        <!-- 5 -->
        <div class="consequence">

            <div class="consequence-top">

                <div>
                    <div class="consequence-title">
                        5️⃣ Jogging
                    </div>

                    <div class="target">
                        Minimal 5 km/jam
                    </div>
                </div>

                <span
                    id="status5"
                    class="status status-pending"
                >
                    BELUM
                </span>

            </div>

            <label>
                Jarak (km)
            </label>

            <input
                type="number"
                id="jarak"
                min="0"
                step="0.01"
                placeholder="Contoh: 5"
            >

            <label>
                Kecepatan rata-rata (km/jam)
            </label>

            <input
                type="number"
                id="speed"
                min="0"
                step="0.01"
                placeholder="Contoh: 5.5"
            >

            <label>
                Bukti jogging
            </label>

            <input
                type="file"
                id="bukti"
                accept="image/*,.pdf"
            >

            <p
                class="small"
                id="fileName"
            >
                Belum ada bukti.
            </p>

            <div class="check-area">

                <input
                    type="checkbox"
                    id="check5"
                >

                <label>
                    Saya menyatakan konsekuensi ini
                    telah terpenuhi
                </label>

            </div>

            <button
                class="btn-green"
                onclick="approveItem(5)"
            >
                ✓ ACC
            </button>

        </div>


        <!-- 6 -->
        <div class="consequence">

            <div class="consequence-top">

                <div>
                    <div class="consequence-title">
                        6️⃣ Klarifikasi di Second
                    </div>

                    <div class="target">
                        Target: selama 1 bulan
                    </div>
                </div>

                <span
                    id="status6"
                    class="status status-pending"
                >
                    BELUM
                </span>

            </div>

            <label>
                Status hari ini
            </label>

            <select id="klarifikasi">

                <option value="belum">
                    Belum dilakukan
                </option>

                <option value="sudah">
                    Sudah dilakukan
                </option>

            </select>

            <div class="check-area">

                <input
                    type="checkbox"
                    id="check6"
                >

                <label>
                    Saya menyatakan konsekuensi ini
                    telah terpenuhi
                </label>

            </div>

            <button
                class="btn-green"
                onclick="approveItem(6)"
            >
                ✓ ACC
            </button>

        </div>

    </div>


    <!-- ADDITIONAL -->
    <div class="card">

        <h2>🙏 Konsekuensi Tambahan</h2>

        <label>
            Jumlah rekaman mengucapkan "minta maaf"
        </label>

        <input
            type="number"
            id="maaf"
            min="0"
            placeholder="Target 200x"
        >

        <div class="target">
            Target: 200x
        </div>

        <br>

        <label>
            Jumlah sit up
        </label>

        <input
            type="number"
            id="situp"
            min="0"
            placeholder="Target 50x"
        >

        <div class="target">
            Target: 50x
        </div>

        <br>

        <label>
            Status baterai HP
        </label>

        <select id="battery">

            <option value="aman">
                HP tidak mati
            </option>

            <option value="mati">
                HP mati / habis baterai
            </option>

        </select>

        <br>

        <button
            class="btn-blue"
            onclick="saveAdditional()"
        >
            💾 Simpan Data
        </button>

    </div>


    <!-- PENALTY -->
    <div class="card">

        <h2>⚠️ Konsekuensi +5</h2>

        <div id="penalty">
            Belum ada data.
        </div>

    </div>


    <!-- FINAL -->
    <div class="card">

        <h2>🔐 Final ACC</h2>

        <p class="small">
            Setelah seluruh konsekuensi hari tersebut
            terpenuhi dan datanya benar, gunakan tombol
            Final ACC.
        </p>

        <br>

        <div class="buttons">

            <button
                class="btn-green"
                onclick="finalApprove()"
            >
                ✅ ACC HARI INI
            </button>

            <button
                class="btn-red"
                onclick="resetDay()"
            >
                🗑️ Hapus Data Hari
            </button>

        </div>

    </div>


    <!-- HISTORY -->
    <div class="card">

        <h2>📋 Riwayat</h2>

        <div id="history">
            Belum ada riwayat.
        </div>

    </div>

</div>


<footer>
    Consequence Tracker • Data tersimpan di browser
</footer>


<script>

/* =====================================================
   DATABASE LOCAL
===================================================== */

let database =
    JSON.parse(
        localStorage.getItem("consequenceDatabase")
    ) || {};

let currentDate =
    new Date().toISOString().split("T")[0];

document.getElementById("date").value =
    currentDate;


/* =====================================================
   TARGET DASAR
===================================================== */

const BASE = {
    pushup: 30,
    lapangan: 3,
    mandi: 2,
    belajarSesi: 3,
    joggingSpeed: 5,
    maaf: 200,
    situp: 50
};


/* =====================================================
   GET DATA
===================================================== */

function getData(date) {

    if (!database[date]) {

        database[date] = {

            name: "",

            items: {
                1: null,
                2: null,
                3: null,
                4: null,
                5: null,
                6: null
            },

            pushup: 0,
            lapangan: 0,
            mandi: 0,

            belajarSesi: 0,
            belajarMenit: 0,

            jarak: 0,
            speed: 0,
            bukti: "",

            klarifikasi: "belum",

            maaf: 0,
            situp: 0,

            battery: "aman",

            approved: false,

            failedCount: 0,
            addedPenalty: 0
        };
    }

    return database[date];
}


/* =====================================================
   SAVE DATABASE
===================================================== */

function saveDatabase() {

    localStorage.setItem(
        "consequenceDatabase",
        JSON.stringify(database)
    );

}


/* =====================================================
   LOAD DAY
===================================================== */

function loadDay() {

    currentDate =
        document.getElementById("date").value;

    if (!currentDate) {
        alert("Pilih tanggal.");
        return;
    }

    const d = getData(currentDate);

    document.getElementById("name").value =
        d.name || "";

    document.getElementById("pushup").value =
        d.pushup || "";

    document.getElementById("lapangan").value =
        d.lapangan || "";

    document.getElementById("mandi").value =
        d.mandi || "";

    document.getElementById("belajarSesi").value =
        d.belajarSesi || "";

    document.getElementById("belajarMenit").value =
        d.belajarMenit || "";

    document.getElementById("jarak").value =
        d.jarak || "";

    document.getElementById("speed").value =
        d.speed || "";

    document.getElementById("klarifikasi").value =
        d.klarifikasi || "belum";

    document.getElementById("maaf").value =
        d.maaf || "";

    document.getElementById("situp").value =
        d.situp || "";

    document.getElementById("battery").value =
        d.battery || "aman";


    for (let i = 1; i <= 6; i++) {

        document.getElementById("check" + i).checked =
            d.items[i] === true;

    }


    updateEverything();

}


/* =====================================================
   NEW DAY
===================================================== */

function newDay() {

    currentDate =
        document.getElementById("date").value;

    if (!currentDate) {
        alert("Pilih tanggal.");
        return;
    }

    getData(currentDate);

    loadDay();

}


/* =====================================================
   APPROVE INDIVIDUAL ITEM
===================================================== */

function approveItem(id) {

    const d = getData(currentDate);

    let valid = false;


    /* PUSH UP */

    if (id === 1) {

        d.pushup =
            Number(
                document.getElementById("pushup").value
            );

        valid =
            d.pushup >= BASE.pushup;
    }


    /* LAPANGAN */

    if (id === 2) {

        d.lapangan =
            Number(
                document.getElementById("lapangan").value
            );

        valid =
            d.lapangan >= BASE.lapangan;
    }


    /* MANDI */

    if (id === 3) {

        d.mandi =
            Number(
                document.getElementById("mandi").value
            );

        valid =
            d.mandi >= BASE.mandi;
    }


    /* BELAJAR */

    if (id === 4) {

        d.belajarSesi =
            Number(
                document.getElementById("belajarSesi").value
            );

        d.belajarMenit =
            Number(
                document.getElementById("belajarMenit").value
            );

        /*
          3 sesi/minggu.
          Untuk ACC harian, minimal durasi
          sesi hari tersebut 30 menit.
        */

        valid =
            d.belajarSesi >= BASE.belajarSesi &&
            d.belajarMenit >= 30;
    }


    /* JOGGING */

    if (id === 5) {

        d.jarak =
            Number(
                document.getElementById("jarak").value
            );

        d.speed =
            Number(
                document.getElementById("speed").value
            );

        const file =
            document.getElementById("bukti").files[0];

        if (file) {
            d.bukti = file.name;
        }

        valid =
            d.jarak >= 5 &&
            d.speed >= BASE.joggingSpeed &&
            d.bukti !== "";
    }


    /* KLARIFIKASI */

    if (id === 6) {

        d.klarifikasi =
            document.getElementById("klarifikasi").value;

        valid =
            d.klarifikasi === "sudah";
    }


    /*
       Checkbox wajib dicentang
       untuk melakukan ACC.
    */

    const checkbox =
        document.getElementById("check" + id);


    if (!checkbox.checked) {

        alert(
            "Centang pernyataan terlebih dahulu."
        );

        return;
    }


    if (!valid) {

        d.items[id] = false;

        saveDatabase();

        updateEverything();

        alert(
            "Data belum memenuhi target."
        );

        return;
    }


    d.items[id] = true;

    saveDatabase();

    updateEverything();

    alert(
        "Konsekuensi #" +
        id +
        " berhasil di-ACC."
    );

}


/* =====================================================
   ADDITIONAL
===================================================== */

function saveAdditional() {

    const d = getData(currentDate);

    d.maaf =
        Number(
            document.getElementById("maaf").value
        );

    d.situp =
        Number(
            document.getElementById("situp").value
        );

    d.battery =
        document.getElementById("battery").value;

    saveDatabase();

    updatePenalty();

    alert(
        "Data tambahan berhasil disimpan."
    );

}


/* =====================================================
   UPDATE EVERYTHING
===================================================== */

function updateEverything() {

    updateStatuses();
    updateStats();
    updatePenalty();
    renderHistory();

}


/* =====================================================
   STATUS
===================================================== */

function updateStatuses() {

    const d = getData(currentDate);

    for (let i = 1; i <= 6; i++) {

        const element =
            document.getElementById("status" + i);

        if (d.items[i] === true) {

            element.innerText =
                "TERPENUHI";

            element.className =
                "status status-done";

        }

        else if (d.items[i] === false) {

            element.innerText =
                "TIDAK TERPENUHI";

            element.className =
                "status status-failed";

        }

        else {

            element.innerText =
                "BELUM";

            element.className =
                "status status-pending";
        }
    }

}


/* =====================================================
   STATS
===================================================== */

function updateStats() {

    const d = getData(currentDate);

    let done = 0;
    let failed = 0;

    for (let i = 1; i <= 6; i++) {

        if (d.items[i] === true)
            done++;

        if (d.items[i] === false)
            failed++;
    }

    const percent =
        Math.round(
            (done / 6) * 100
        );

    document.getElementById("done")
        .innerText = done;

    document.getElementById("failed")
        .innerText = failed;

    document.getElementById("percent")
        .innerText = percent + "%";

    document.getElementById("progress")
        .style.width = percent + "%";

    document.getElementById("progressText")
        .innerText =
        done + " / 6 terpenuhi";
}


/* =====================================================
   PENALTY +5
===================================================== */

function updatePenalty() {

    const d = getData(currentDate);

    let failed = 0;

    for (let i = 1; i <= 6; i++) {

        if (d.items[i] === false)
            failed++;
    }


    /*
       Tambahan penalty dihitung:
       setiap konsekuensi gagal = +5
    */

    const penalty =
        failed * 5;

    d.failedCount =
        failed;

    d.addedPenalty =
        penalty;

    saveDatabase();


    const container =
        document.getElementById("penalty");


    if (failed === 0) {

        container.innerHTML = `
            <div class="success-box">
                ✅ Belum ada konsekuensi yang
                tercatat gagal.
            </div>
        `;

        return;
    }


    container.innerHTML = `
        <div class="penalty-box">

            ⚠️ Terdapat
            <strong>${failed}</strong>
            konsekuensi yang tidak terpenuhi.

            <br><br>

            Penambahan administratif:

            <strong>
                +${penalty}
            </strong>

            <br><br>

            Rumus:
            ${failed} × 5 = ${penalty}

        </div>
    `;

}


/* =====================================================
   FINAL APPROVE
===================================================== */

function finalApprove() {

    const d = getData(currentDate);

    let done = 0;

    for (let i = 1; i <= 6; i++) {

        if (d.items[i] === true)
            done++;
    }


    if (done !== 6) {

        alert(
            "Belum bisa Final ACC.\n\n" +
            "Konsekuensi terpenuhi: " +
            done +
            "/6"
        );

        return;
    }


    /*
       Simpan tambahan
    */

    d.maaf =
        Number(
            document.getElementById("maaf").value
        );

    d.situp =
        Number(
            document.getElementById("situp").value
        );

    d.battery =
        document.getElementById("battery").value;


    d.approved = true;

    saveDatabase();

    updateEverything();

    alert(
        "✅ FINAL ACC BERHASIL!\n\n" +
        currentDate
    );

}


/* =====================================================
   RESET DAY
===================================================== */

function resetDay() {

    const confirmDelete =
        confirm(
            "Yakin ingin menghapus seluruh data tanggal " +
            currentDate +
            "?"
        );

    if (!confirmDelete)
        return;


    delete database[currentDate];

    saveDatabase();

    location.reload();

}


/* =====================================================
   HISTORY
===================================================== */

function renderHistory() {

    const container =
        document.getElementById("history");

    const dates =
        Object.keys(database)
        .sort()
        .reverse();


    if (dates.length === 0) {

        container.innerHTML =
            "Belum ada riwayat.";

        return;
    }


    container.innerHTML = "";


    dates.forEach(date => {

        const d =
            database[date];

        let done = 0;

        for (let i = 1; i <= 6; i++) {

            if (d.items[i] === true)
                done++;
        }


        const div =
            document.createElement("div");

        div.className =
            "history-item";


        div.innerHTML = `

            <div class="history-header">

                <strong>
                    📅 ${date}
                </strong>

                ${
                    d.approved

                    ?

                    '<span class="approved">✅ ACC</span>'

                    :

                    '<span class="not-approved">⏳ Belum ACC</span>'
                }

            </div>


            <div class="small">

                Progress:
                <strong>
                    ${done}/6
                </strong>

                <br><br>

                Push Up:
                ${d.pushup || 0}x

                <br>

                Lapangan:
                ${d.lapangan || 0}x

                <br>

                Mandi:
                ${d.mandi || 0}x

                <br>

                Belajar:
                ${d.belajarSesi || 0} sesi

                <br>

                Jogging:
                ${d.jarak || 0} km
                @
                ${d.speed || 0} km/jam

                <br>

                Klarifikasi:
                ${d.klarifikasi === "sudah"
                    ? "Sudah"
                    : "Belum"}

                <br>

                Minta maaf:
                ${d.maaf || 0}/200

                <br>

                Sit Up:
                ${d.situp || 0}/50

                <br>

                Baterai:
                ${d.battery === "aman"
                    ? "Aman"
                    : "HP mati"}

                <br>

                Penambahan:
                +${d.addedPenalty || 0}

            </div>
        `;


        container.appendChild(div);

    });

}


/* =====================================================
   FILE NAME
===================================================== */

document
.getElementById("bukti")
.addEventListener(
    "change",
    function() {

        const file =
            this.files[0];

        if (!file)
            return;

        document.getElementById(
            "fileName"
        ).innerText =
            "Bukti: " + file.name;

    }
);


/* =====================================================
   DATE CHANGE
===================================================== */

document
.getElementById("date")
.addEventListener(
    "change",
    function() {

        currentDate =
            this.value;

        loadDay();

    }
);


/* =====================================================
   START
===================================================== */

getData(currentDate);

loadDay();

renderHistory();

</script>

